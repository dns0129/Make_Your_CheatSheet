{
  "name": "make-your-cheatsheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy server/index.mjs",
    "build": "node scripts/build-worker.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "pi:login": "node --use-env-proxy scripts/pi-login.mjs",
