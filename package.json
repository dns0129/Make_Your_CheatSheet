    "vendor": "node scripts/vendor.mjs"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "mammoth": "1.11.0",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "esbuild": "0.27.4",
    "jsdom": "26.1.0"
  }
}
